{
  "name": "pharmachain",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "bun run --filter @pharmachain/db build",
    "db:push": "bun run --filter @pharmachain/db db:push",
    "db:seed": "bun run --filter @pharmachain/db db:seed",
    "db:studio": "bun run --filter @pharmachain/db db:studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "turbo": "^2.10.0",
    "typescript": "^5.9.3"
  }
}
