// PharmaChain Phase 1 MVP schema.
// Enum values mirror @pharmachain/core (client code imports enums from core,
// never from @prisma/client).

generator client {
  provider      = "prisma-client-js"
  // native: dev · debian: Docker image · rhel: Vercel/AWS Lambda functions
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum CompanyType {
  RAW_MATERIAL_MANUFACTURER
  FINISHED_PRODUCT_MANUFACTURER
  SUPPLIER
  FREIGHT_FORWARDER
  CLEARING_AGENT
  TRANSPORTER
}

enum VerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  EXPIRED_DOCUMENT
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
}

enum SubscriptionTier {
  FREEMIUM
  PREMIUM
  FEATURED
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum CompanyRole {
  COMPANY_ADMIN
  OPERATIONS
  FINANCE
}

enum LoginMethod {
  PASSWORD
  OTP
}

enum ListingKind {
  RAW_MATERIAL
  FINISHED_PRODUCT
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  DEACTIVATED
}

enum DocumentKind {
  CERTIFICATE_OF_INCORPORATION
  TRADING_LICENCE
  TAX_ID
  IMPORT_EXPORT_LICENCE
  MANUFACTURING_LICENCE
  GMP_CERTIFICATE
  OTHER_COMPLIANCE
  PROFORMA_INVOICE
  CERTIFICATE_OF_ANALYSIS
  QUALITY_CERTIFICATE
  SHIPPING_INSTRUCTIONS
  BILL_OF_LADING
  AIR_WAYBILL
  COMMERCIAL_INVOICE
  PACKING_LIST
  CERTIFICATE_OF_ORIGIN
  CUSTOMS_DECLARATION
  DANGEROUS_GOODS_DECLARATION
  PHYTOSANITARY_CERTIFICATE
  TAX_WORKSHEET
  PROOF_OF_DELIVERY_PHOTO
  SDS
  RFQ_ATTACHMENT
  QUOTATION_ATTACHMENT
  MESSAGE_ATTACHMENT
  COMPANY_LOGO
  OTHER
}

enum DocumentStatus {
  ACTIVE
  SUPERSEDED
  DELETED
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum RfqStatus {
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum QuotationStatus {
  ACTIVE
  SUPERSEDED
  WITHDRAWN
  EXPIRED
  ACCEPTED
}

enum OrderStatus {
  ORDER_CONFIRMED
  PICKUP_SCHEDULED
  GOODS_COLLECTED
  IN_TRANSIT
  AT_PORT_OF_ORIGIN
  CUSTOMS_ORIGIN
  DEPARTED
  AT_PORT_OF_DESTINATION
  CUSTOMS_DESTINATION
  INLAND_TRANSPORT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_CONFIRMED
}

enum FreightMode {
  SEA
  AIR
  LAND
  MULTIMODAL
}

enum LogisticsRole {
  FORWARDER
  CLEARING_AGENT
  TRANSPORTER
}

enum AppointmentStatus {
  ACTIVE
  REVOKED
}

enum DisputeStatus {
  OPEN
  ESCALATED
  RESOLVED
  WITHDRAWN
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  ESCROW
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum LedgerEntryKind {
  INVOICE_ISSUED
  INVOICE_RECEIVED
  PAYMENT_IN
  PAYMENT_OUT
  PLATFORM_FEE
  CREDIT_PURCHASE
}

enum RatingStatus {
  PUBLISHED
  FLAGGED
  REMOVED
}

enum BomStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum NotificationType {
  NEW_MESSAGE
  NEW_QUOTATION
  RFQ_STATUS_CHANGE
  SHIPMENT_STATUS_CHANGE
  DOCUMENT_UPLOADED
  DOCUMENT_EXPIRY
  VERIFICATION_DECISION
  ANNOUNCEMENT
  USAGE_LIMIT_WARNING
  CREDIT_UPDATE
  TIER_CHANGE
  ACCOUNT_UPDATE
  DATA_REQUEST
  SHIPMENT_DELAYED
  CUSTOMS_ALERT
  DELIVERY_FAILED
  DOCUMENT_MISSING
  DISPUTE_UPDATE
  APPROVAL_PENDING
  PAYMENT_OVERDUE
}

enum AnnouncementAudience {
  ALL
  ROLE
  COMPANY
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  RETRACTED
}

enum CreditKind {
  RFQ
  QUOTATION
  FEATURED
  VERIFICATION_PREMIUM
  DATA_INSIGHTS
}

enum CreditStatus {
  PENDING_PAYMENT
  CONFIRMED
  REJECTED
}

enum DataRequestStatus {
  PENDING
  COMPLETED
}

// ─── Identity & access ───────────────────────────────────────────────────────

model Company {
  id                      String             @id @default(uuid(7)) @db.Uuid
  name                    String
  type                    CompanyType
  country                 String
  address                 String
  registrationNumber      String             @unique
  primaryContactName      String
  primaryContactEmail     String
  primaryContactPhone     String?
  website                 String?
  verificationStatus      VerificationStatus @default(PENDING_VERIFICATION)
  rejectionReason         String?
  verifiedAt              DateTime?
  verifiedById            String?            @db.Uuid
  reverificationDueAt     DateTime?
  subscriptionTier        SubscriptionTier   @default(FREEMIUM)
  // Phase 3 §2: AML/KYC review on the company financial profile
  kycReviewedAt           DateTime?
  kycRiskLevel            String?
  // Phase 4 §3: trust system — nightly-granted badge + paid featured placement
  trustedBadgeAt          DateTime?
  featuredUntil           DateTime?
  // Phase 5 §4: data-insights subscription window
  insightsUntil           DateTime?
  // Phase 4 §4: chemical-handling & environmental compliance profile
  reachStatus             String?
  ehsReport               String?
  // Public profile (US-301); publishable once VERIFIED
  profileDescription      String?
  profileStatus           ProfileStatus      @default(DRAFT)
  profilePublishedAt      DateTime?
  countriesOfOperation    String[]           @default([])
  displayedCertifications String[]           @default([])
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  members                CompanyUserRole[]
  invites                Invite[]
  documents              Document[]
  listings               Listing[]
  rfqs                   Rfq[]
  quotations             Quotation[]
  ordersAsBuyer          Order[]           @relation("OrderBuyer")
  ordersAsSeller         Order[]           @relation("OrderSeller")
  threadsAsBuyer         MessageThread[]   @relation("ThreadBuyer")
  threadsAsSupplier      MessageThread[]   @relation("ThreadSupplier")
  creditRequests         CreditRequest[]
  announcementsTargeted  Announcement[]
  shipmentAppointments   ShipmentAppointment[]
  disputesRaised         Dispute[]
  paymentsMade           Payment[]
  invoicesIssued         Invoice[]         @relation("InvoiceIssuer")
  invoicesReceived       Invoice[]         @relation("InvoiceRecipient")
  ledgerEntries          LedgerEntry[]
  ratingsGiven           Rating[]          @relation("RatingsGiven")
  ratingsReceived        Rating[]          @relation("RatingsReceived")
  webhooks               Webhook[]
  apiKeys                ApiKey[]

  @@index([verificationStatus])
  @@index([type, verificationStatus])
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  email              String     @unique
  name               String
  passwordHash       String?
  status             UserStatus @default(ACTIVE)
  isSuperAdmin       Boolean    @default(false)
  // Bumped to invalidate all sessions (deactivation, password reset, override)
  sessionVersion     Int        @default(1)
  whatsappNumber     String?
  whatsappVerifiedAt DateTime?
  // Challenge-response number verification (US-604): code sent over the
  // WhatsApp channel itself, stored hashed like the email OTP.
  whatsappVerifyCodeHash  String?
  whatsappVerifyExpiresAt DateTime?
  // TOTP second factor (RFC 6238); secret stored base32, presence + enabledAt
  // gate the login challenge.
  totpSecret         String?
  totpEnabledAt      DateTime?
  // Phase 3 §3: preferred display currency (null = listing currency as-is)
  preferredCurrency  String?
  // Phase 4 §4: locale-aware formatting + time-zone handling
  locale             String?
  timeZone           String?
  lastLoginAt        DateTime?
  deactivatedAt      DateTime?
  anonymizedAt       DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  membership              CompanyUserRole?
  savedSearches           SavedSearch[]
  invitesSent             Invite[]
  passwordResetTokens     PasswordResetToken[]
  loginActivity           LoginActivity[]
  documentsUploaded       Document[]
  rfqsCreated             Rfq[]
  quotationsSubmitted     Quotation[]
  ordersCreated           Order[]
  orderStatusEvents       OrderStatusEvent[]
  bomsCreated             Bom[]
  messages                Message[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  announcementsCreated    Announcement[]
  creditRequestsMade      CreditRequest[]
  dataDeletionRequests    DataDeletionRequest[]
  driverProfile           DriverProfile?
  appointmentsMade        ShipmentAppointment[]
  locationsRecorded       ShipmentLocation[]
  podsCaptured            ProofOfDelivery[]
  disputesRaised          Dispute[]
  paymentsRecorded        Payment[]
  invoicesIssued          Invoice[]
  scheduledReports        ScheduledReport[]
  ratingsAuthored         Rating[]
  pushSubscriptions       PushSubscription[]
  dashboardPreference     DashboardPreference?
}

// One membership per user in Phase 1 (US-201: an email active in another
// company is rejected). Kept as a join table so multi-company membership is a
// dropped constraint away, not a migration.
model CompanyUserRole {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @unique @db.Uuid
  companyId String      @db.Uuid
  role      CompanyRole
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Invite {
  id          String      @id @default(uuid(7)) @db.Uuid
  companyId   String      @db.Uuid
  email       String
  role        CompanyRole
  tokenHash   String      @unique
  invitedById String      @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  invitedBy User    @relation(fields: [invitedById], references: [id])

  @@index([companyId])
  @@index([email])
}

model PasswordResetToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EmailOtp {
  id         String    @id @default(uuid(7)) @db.Uuid
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model LoginActivity {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String?     @db.Uuid
  email     String
  method    LoginMethod
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Category {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String       @unique
  kind        ListingKind?
  description String?
  createdAt   DateTime     @default(now())

  listings Listing[]
  rfqs     Rfq[]
  bomItems BomItem[]
}

model Listing {
  id                String        @id @default(uuid(7)) @db.Uuid
  companyId         String        @db.Uuid
  kind              ListingKind
  name              String
  casNumber         String?
  ghsClassification String?
  countryOfOrigin   String
  packagingType     String
  packSize          String
  unit              String
  hsCode            String?
  shelfLifeMonths   Int?
  storageConditions String?
  certifications    String[]      @default([])
  // Phase 4 §4: pharmacopoeia standards the material/product conforms to
  standards         String[]      @default([])
  categoryId        String        @db.Uuid
  price             Decimal       @db.Decimal(14, 4)
  currency          String
  description       String?
  status            ListingStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  category  Category   @relation(fields: [categoryId], references: [id])
  documents Document[]
  boms      Bom[]

  @@index([companyId, status])
  @@index([status, kind])
  @@index([categoryId])
  @@index([countryOfOrigin])
}

// Display FX rates. Phase 3 §3: refreshed daily from a live feed (source
// LIVE) with the admin-managed manual rows as the documented fallback.
model ExchangeRate {
  id        String   @id @default(uuid(7)) @db.Uuid
  base      String
  quote     String
  rate      Decimal  @db.Decimal(16, 8)
  source    String   @default("MANUAL")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([base, quote])
}

// ─── Documents ───────────────────────────────────────────────────────────────

model Document {
  id                String         @id @default(uuid(7)) @db.Uuid
  ownerCompanyId    String         @db.Uuid
  uploadedById      String         @db.Uuid
  kind              DocumentKind
  fileName          String
  contentType       String
  size              Int
  storageKey        String         @unique
  expiresAt         DateTime?
  version           Int            @default(1)
  supersededById    String?        @db.Uuid
  status            DocumentStatus @default(ACTIVE)
  scanStatus        ScanStatus     @default(PENDING)
  uploadCompletedAt DateTime?
  lastExpiryAlertAt DateTime?
  // Optional business links — at most one, enforced at the contract layer
  listingId         String?        @db.Uuid
  rfqId             String?        @db.Uuid
  quotationId       String?        @db.Uuid
  orderId           String?        @db.Uuid
  messageId         String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  ownerCompany Company    @relation(fields: [ownerCompanyId], references: [id])
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  listing      Listing?   @relation(fields: [listingId], references: [id])
  rfq          Rfq?       @relation(fields: [rfqId], references: [id])
  quotation    Quotation? @relation(fields: [quotationId], references: [id])
  order        Order?     @relation(fields: [orderId], references: [id])
  message      Message?   @relation(fields: [messageId], references: [id])
  supersededBy Document?  @relation("DocumentVersions", fields: [supersededById], references: [id])
  supersedes   Document[] @relation("DocumentVersions")

  @@index([ownerCompanyId, kind, status])
  @@index([expiresAt, status])
  @@index([orderId])
  @@index([listingId])
}

// ─── RFQ → Quotation → Order ─────────────────────────────────────────────────

model Rfq {
  id                   String      @id @default(uuid(7)) @db.Uuid
  refNo                String      @unique
  buyerCompanyId       String      @db.Uuid
  createdById          String      @db.Uuid
  title                String
  specifications       String?
  quantity             Decimal     @db.Decimal(16, 4)
  unit                 String
  targetCompanyType    CompanyType
  categoryId           String?     @db.Uuid
  deadline             DateTime
  status               RfqStatus   @default(OPEN)
  visibleSupplierCount Int         @default(0)
  bomItemId            String?     @db.Uuid
  awardedAt            DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  buyerCompany Company         @relation(fields: [buyerCompanyId], references: [id])
  createdBy    User            @relation(fields: [createdById], references: [id])
  category     Category?       @relation(fields: [categoryId], references: [id])
  bomItem      BomItem?        @relation(fields: [bomItemId], references: [id])
  quotations   Quotation[]
  documents    Document[]
  threads      MessageThread[]
  order        Order?

  @@index([status, deadline])
  @@index([buyerCompanyId, createdAt])
  @@index([targetCompanyType, status])
}

model Quotation {
  id                String          @id @default(uuid(7)) @db.Uuid
  refNo             String          @unique
  rfqId             String          @db.Uuid
  supplierCompanyId String          @db.Uuid
  submittedById     String          @db.Uuid
  version           Int             @default(1)
  unitPrice         Decimal         @db.Decimal(14, 4)
  currency          String
  totalPrice        Decimal         @db.Decimal(16, 2)
  leadTimeDays      Int
  validUntil        DateTime
  notes             String?
  status            QuotationStatus @default(ACTIVE)
  withdrawnAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  rfq             Rfq            @relation(fields: [rfqId], references: [id])
  supplierCompany Company        @relation(fields: [supplierCompanyId], references: [id])
  submittedBy     User           @relation(fields: [submittedById], references: [id])
  documents       Document[]
  thread          MessageThread?
  order           Order?

  // Resubmission = new row with version+1; prior row becomes SUPERSEDED
  // inside the same transaction. Partial unique indexes aren't expressible in
  // Prisma's DSL — migration 20260717090001_business_invariants additionally
  // enforces at most one non-SUPERSEDED row per (rfqId, supplierCompanyId).
  @@unique([rfqId, supplierCompanyId, version])
  @@index([supplierCompanyId, createdAt])
  @@index([rfqId, status])
}

model Order {
  id             String      @id @default(uuid(7)) @db.Uuid
  orderNo        String      @unique
  rfqId          String      @unique @db.Uuid
  quotationId    String      @unique @db.Uuid
  buyerCompanyId String      @db.Uuid
  sellerCompanyId String     @db.Uuid
  createdById    String      @db.Uuid
  // Snapshot of the awarded terms (US-405)
  title          String
  quantity       Decimal     @db.Decimal(16, 4)
  unit           String
  unitPrice      Decimal     @db.Decimal(14, 4)
  currency       String
  totalAmount    Decimal     @db.Decimal(16, 2)
  status         OrderStatus @default(ORDER_CONFIRMED)
  eta            DateTime?
  forwarderName  String?
  forwarderEmail String?
  // Phase 2 logistics metadata (managed by seller/appointed forwarder)
  freightMode         FreightMode?
  coldChain           Boolean      @default(false)
  dispatchDate        DateTime?
  deliveryConfirmedAt DateTime?
  // Hazard/phyto flags detected at order creation drive the document prompts
  dangerousGoods      Boolean      @default(false)
  phytoRequired       Boolean      @default(false)
  // Alert-engine dedupe markers (one delay/doc alert per day per order)
  lastDelayAlertAt    DateTime?
  lastDocAlertAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  rfq           Rfq                @relation(fields: [rfqId], references: [id])
  quotation     Quotation          @relation(fields: [quotationId], references: [id])
  buyerCompany  Company            @relation("OrderBuyer", fields: [buyerCompanyId], references: [id])
  sellerCompany Company            @relation("OrderSeller", fields: [sellerCompanyId], references: [id])
  createdBy     User               @relation(fields: [createdById], references: [id])
  statusEvents  OrderStatusEvent[]
  documents     Document[]
  thread        MessageThread?
  appointments  ShipmentAppointment[]
  locations     ShipmentLocation[]
  pod           ProofOfDelivery?
  disputes      Dispute[]
  payments      Payment[]
  invoices      Invoice[]
  ratings       Rating[]
  traceEvents   TraceEvent[]

  @@index([buyerCompanyId, createdAt])
  @@index([sellerCompanyId, createdAt])
  @@index([status])
  @@index([eta, status])
}

// Shipment-stage history (US-702): every transition with note and ETA.
// Rows with `exception` set annotate the CURRENT stage (delay, customs
// rejection, failed delivery attempt) instead of moving it.
model OrderStatusEvent {
  id          String      @id @default(uuid(7)) @db.Uuid
  orderId     String      @db.Uuid
  status      OrderStatus
  note        String?
  eta         DateTime?
  exception   String?
  actorUserId String      @db.Uuid
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])
  actor User  @relation(fields: [actorUserId], references: [id])

  @@index([orderId, createdAt])
}

// ─── Phase 2: logistics operations ───────────────────────────────────────────

// Buyer appoints one forwarder and one clearing agent (and a transporter for
// road legs) per shipment; the appointee's staff gain access to exactly that
// shipment. One ACTIVE row per (order, role) — enforced by a partial unique
// index in the Phase 2 migration.
model ShipmentAppointment {
  id            String            @id @default(uuid(7)) @db.Uuid
  orderId       String            @db.Uuid
  role          LogisticsRole
  companyId     String            @db.Uuid
  appointedById String            @db.Uuid
  status        AppointmentStatus @default(ACTIVE)
  revokedAt     DateTime?
  createdAt     DateTime          @default(now())

  order       Order   @relation(fields: [orderId], references: [id])
  company     Company @relation(fields: [companyId], references: [id])
  appointedBy User    @relation(fields: [appointedById], references: [id])

  @@index([orderId, role, status])
  @@index([companyId, status, createdAt])
}

// Driver profile for transporter staff (delivery instructions reach them
// through the normal notification fan-out to their user account).
model DriverProfile {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @unique @db.Uuid
  licenceNo        String
  vehicleReg       String
  vehicleType      String?
  coldChainCapable Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// GPS pings recorded by the transporter/forwarder on road legs (Phase 2 §3:
// location updates at least every 6 hours while a road leg is active).
model ShipmentLocation {
  id           String   @id @default(uuid(7)) @db.Uuid
  orderId      String   @db.Uuid
  lat          Decimal  @db.Decimal(9, 6)
  lng          Decimal  @db.Decimal(9, 6)
  note         String?
  recordedById String   @db.Uuid
  createdAt    DateTime @default(now())

  order      Order @relation(fields: [orderId], references: [id])
  recordedBy User  @relation(fields: [recordedById], references: [id])

  @@index([orderId, createdAt])
}

// Proof of delivery: signature (typed + optional drawn) and/or photo
// document, captured once per order at the delivery stages.
model ProofOfDelivery {
  id              String   @id @default(uuid(7)) @db.Uuid
  orderId         String   @unique @db.Uuid
  signedByName    String
  signatureData   String?
  photoDocumentId String?  @db.Uuid
  note            String?
  capturedById    String   @db.Uuid
  capturedAt      DateTime @default(now())

  order      Order @relation(fields: [orderId], references: [id])
  capturedBy User  @relation(fields: [capturedById], references: [id])
}

// ─── Phase 5: intelligence & marketplace scale ───────────────────────────────

// Cryptographically chained traceability ledger (Phase 5 §2): every supply-
// chain event on an order links to its predecessor by hash, so any tampering
// breaks verification. Append-only — a DB trigger (added in the Phase 5
// migration, same pattern as AuditLog) rejects UPDATE/DELETE outright.
model TraceEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  orderId     String   @db.Uuid
  seq         Int
  type        String
  at          String
  payload     Json
  payloadHash String
  prevHash    String
  hash        String
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, seq])
  @@index([orderId])
  @@index([hash])
}

// Partner webhooks (Phase 5 §3): signed real-time push to external systems
// (ERP, accounting, port community systems) with retries + replay protection.
model Webhook {
  id            String    @id @default(uuid(7)) @db.Uuid
  companyId     String    @db.Uuid
  url           String
  secret        String
  events        String[]
  active        Boolean   @default(true)
  failCount     Int       @default(0)
  lastSuccessAt DateTime?
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())

  company    Company           @relation(fields: [companyId], references: [id])
  deliveries WebhookDelivery[]

  @@index([companyId])
}

model WebhookDelivery {
  id            String    @id @default(uuid(7)) @db.Uuid
  webhookId     String    @db.Uuid
  event         String
  payload       Json
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  deliveredAt   DateTime?
  lastStatus    Int?
  lastError     String?
  createdAt     DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id])

  @@index([deliveredAt, nextAttemptAt])
  @@index([webhookId, createdAt])
}

// Partner/public API keys (Phase 5 §4): hashed at rest, scoped, per-key
// rate-limited through the durable throttle storage.
model ApiKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @db.Uuid
  name           String
  prefix         String
  hashedKey      String    @unique
  scopes         String[]
  rateLimitPerMin Int      @default(60)
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// ─── Phase 4: analytics, mobile & compliance ─────────────────────────────────

// One rating per (engagement, rater, ratee), verified against the shipment
// record (Phase 4 §3): the order must be delivered and the target must have
// been the seller or an appointed logistics partner on it.
model Rating {
  id              String       @id @default(uuid(7)) @db.Uuid
  orderId         String       @db.Uuid
  raterCompanyId  String       @db.Uuid
  targetCompanyId String       @db.Uuid
  targetRole      String
  stars           Int
  comment         String?
  status          RatingStatus @default(PUBLISHED)
  flaggedReason   String?
  moderatedById   String?      @db.Uuid
  createdById     String       @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  rater   Company @relation("RatingsGiven", fields: [raterCompanyId], references: [id])
  target  Company @relation("RatingsReceived", fields: [targetCompanyId], references: [id])
  author  User    @relation(fields: [createdById], references: [id])

  @@unique([orderId, raterCompanyId, targetCompanyId])
  @@index([targetCompanyId, status])
}

// Web Push subscriptions (Phase 4 §1): payloads encrypted per RFC 8291,
// VAPID-authenticated; dead endpoints are pruned on 404/410.
model PushSubscription {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Per-user dashboard layout (Phase 4 §2): ordered widget keys.
model DashboardPreference {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @db.Uuid
  widgets   Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ─── Phase 3: payments & financial tools ─────────────────────────────────────

// Payment records against an order (Phase 3 §1). The platform never holds
// funds: rows track money moving directly between the parties, initiated
// through a gateway adapter (manual bank instructions, mock gateway, or an
// env-gated real provider). Partial/instalment payments = multiple rows;
// the running balance is total − sum(CONFIRMED).
model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  orderId        String        @db.Uuid
  payerCompanyId String        @db.Uuid
  method         PaymentMethod
  provider       String
  providerRef    String        @unique
  amount         Decimal       @db.Decimal(16, 2)
  currency       String
  status         PaymentStatus @default(PENDING)
  note           String?
  recordedById   String        @db.Uuid
  confirmedById  String?       @db.Uuid
  confirmedAt    DateTime?
  failureReason  String?
  // Raw webhook payload retained for reconciliation evidence
  webhookPayload Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order      Order   @relation(fields: [orderId], references: [id])
  payer      Company @relation(fields: [payerCompanyId], references: [id])
  recordedBy User    @relation(fields: [recordedById], references: [id])

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

// Invoices with per-issuer sequential numbering (Phase 3 §2). Tax and duty
// are computed from the admin-maintained TaxRule table (HS code + origin +
// destination) and stamped with the FX rate so historical amounts stay
// reproducible.
model Invoice {
  id                 String        @id @default(uuid(7)) @db.Uuid
  invoiceNo          String        @unique
  seq                Int
  issuerCompanyId    String        @db.Uuid
  recipientCompanyId String        @db.Uuid
  orderId            String        @db.Uuid
  status             InvoiceStatus @default(ISSUED)
  lines              Json
  subtotal           Decimal       @db.Decimal(16, 2)
  dutyAmount         Decimal       @db.Decimal(16, 2)
  vatAmount          Decimal       @db.Decimal(16, 2)
  total              Decimal       @db.Decimal(16, 2)
  currency           String
  hsCode             String?
  originCountry      String?
  destCountry        String?
  dutyRatePct        Decimal?      @db.Decimal(6, 3)
  vatRatePct         Decimal?      @db.Decimal(6, 3)
  // FX stamp: rate to USD at issue time, for reproducible reporting
  fxRateToUsd        Decimal?      @db.Decimal(16, 8)
  fxStampedAt        DateTime?
  // Phase 5 §3: credit terms (invoice financing) — net-N days
  paymentTermsDays   Int?
  documentId         String?       @db.Uuid
  issuedById         String        @db.Uuid
  paidAt             DateTime?
  voidedAt           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  issuer    Company @relation("InvoiceIssuer", fields: [issuerCompanyId], references: [id])
  recipient Company @relation("InvoiceRecipient", fields: [recipientCompanyId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id])
  issuedBy  User    @relation(fields: [issuedById], references: [id])

  @@unique([issuerCompanyId, seq])
  @@index([recipientCompanyId, createdAt])
  @@index([orderId])
  @@index([status, createdAt])
}

// Append-only per-company financial ledger (Phase 3 §2): every financial
// event lands here; amounts are signed (in +, out −).
model LedgerEntry {
  id        String          @id @default(uuid(7)) @db.Uuid
  companyId String          @db.Uuid
  kind      LedgerEntryKind
  amount    Decimal         @db.Decimal(16, 2)
  currency  String
  refType   String
  refId     String
  note      String?
  createdAt DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
}

// Admin-maintained duty/VAT rules keyed by HS-code prefix and lane
// (Phase 3 §2). Longest matching hsPrefix wins; null origin matches any.
model TaxRule {
  id          String   @id @default(uuid(7)) @db.Uuid
  hsPrefix    String
  originCountry String?
  destCountry String
  dutyRatePct Decimal  @db.Decimal(6, 3)
  vatRatePct  Decimal  @db.Decimal(6, 3)
  notes       String?
  active      Boolean  @default(true)
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([destCountry, active])
}

// Opt-in scheduled financial report delivery (Phase 3 §4).
model ScheduledReport {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  report     String
  frequency  String
  active     Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, report])
}

// Exception & dispute management (Phase 2 §4): a party raises a complaint
// against a shipment, may escalate to platform admin; the full trail is
// audited and every update notifies the parties.
model Dispute {
  id                String        @id @default(uuid(7)) @db.Uuid
  orderId           String        @db.Uuid
  raisedByCompanyId String        @db.Uuid
  raisedById        String        @db.Uuid
  subject           String
  body              String
  legalReference    String?
  status            DisputeStatus @default(OPEN)
  escalatedAt       DateTime?
  resolvedAt        DateTime?
  resolvedById      String?       @db.Uuid
  resolution        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order    Order   @relation(fields: [orderId], references: [id])
  raisedBy User    @relation(fields: [raisedById], references: [id])
  company  Company @relation(fields: [raisedByCompanyId], references: [id])

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

// ─── BOM ─────────────────────────────────────────────────────────────────────

model Bom {
  id               String    @id @default(uuid(7)) @db.Uuid
  productListingId String    @db.Uuid
  version          Int       @default(1)
  status           BomStatus @default(DRAFT)
  notes            String?
  createdById      String    @db.Uuid
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  productListing Listing   @relation(fields: [productListingId], references: [id])
  createdBy      User      @relation(fields: [createdById], references: [id])
  items          BomItem[]

  // One ACTIVE version per product: enforced transactionally (activate
  // archives the prior ACTIVE row first) and by a partial unique index in
  // migration 20260717090001_business_invariants.
  @@unique([productListingId, version])
  @@index([productListingId, status])
}

model BomItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  bomId           String   @db.Uuid
  materialName    String
  categoryId      String?  @db.Uuid
  quantityPerUnit Decimal  @db.Decimal(16, 6)
  unit            String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  bom      Bom       @relation(fields: [bomId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  rfqs     Rfq[]

  @@index([bomId])
}

// ─── Messaging & notifications ───────────────────────────────────────────────

// Threads are pairwise between buyer and supplier. RFQ threads exist per
// (rfq, supplier) so suppliers never see each other (US-406); quotation and
// order threads are naturally pairwise.
model MessageThread {
  id                  String    @id @default(uuid(7)) @db.Uuid
  buyerCompanyId      String    @db.Uuid
  supplierCompanyId   String    @db.Uuid
  rfqId               String?   @db.Uuid
  quotationId         String?   @unique @db.Uuid
  orderId             String?   @unique @db.Uuid
  // Skip-throttle marker: max 1 email per thread per 10 minutes (US-603)
  lastEmailNotifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  buyerCompany    Company    @relation("ThreadBuyer", fields: [buyerCompanyId], references: [id])
  supplierCompany Company    @relation("ThreadSupplier", fields: [supplierCompanyId], references: [id])
  rfq             Rfq?       @relation(fields: [rfqId], references: [id])
  quotation       Quotation? @relation(fields: [quotationId], references: [id])
  order           Order?     @relation(fields: [orderId], references: [id])
  messages        Message[]

  @@unique([rfqId, supplierCompanyId])
  @@index([buyerCompanyId])
  @@index([supplierCompanyId])
}

model Message {
  id              String       @id @default(uuid(7)) @db.Uuid
  threadId        String       @db.Uuid
  senderId        String       @db.Uuid
  senderCompanyId String       @db.Uuid
  senderRole      CompanyRole?
  body            String
  createdAt       DateTime     @default(now())

  thread      MessageThread @relation(fields: [threadId], references: [id])
  sender      User          @relation(fields: [senderId], references: [id])
  attachments Document[]

  @@index([threadId, createdAt])
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Per-event opt-out for email/WhatsApp; in-app is always delivered (US-606).
model NotificationPreference {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  eventType NotificationType
  email     Boolean          @default(true)
  whatsapp  Boolean          @default(true)
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, eventType])
}

// ─── Platform administration ─────────────────────────────────────────────────

model Announcement {
  id              String               @id @default(uuid(7)) @db.Uuid
  title           String
  body            String
  audience        AnnouncementAudience
  targetRole      CompanyRole?
  targetCompanyId String?              @db.Uuid
  status          AnnouncementStatus   @default(PUBLISHED)
  expiresAt       DateTime?
  createdById     String               @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  targetCompany Company? @relation(fields: [targetCompanyId], references: [id])
  createdBy     User     @relation(fields: [createdById], references: [id])

  @@index([status, expiresAt])
}

model SystemParameter {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  value       String
  type        String
  description String
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Pay-per-use credit requests beyond the Freemium limit (US-907).
// Confirmed credits count toward the month of `decidedAt`.
model CreditRequest {
  id            String       @id @default(uuid(7)) @db.Uuid
  companyId     String       @db.Uuid
  kind          CreditKind
  count         Int
  fee           Decimal      @db.Decimal(12, 2)
  currency      String       @default("USD")
  status        CreditStatus @default(PENDING_PAYMENT)
  requestedById String       @db.Uuid
  confirmedById String?      @db.Uuid
  note          String?
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())
  // In-platform settlement of the platform fee. Nullable throughout: a request
  // raised before checkout existed, or paid by arrangement, still settles
  // through the admin queue. Card/mobile-money requests are confirmed by the
  // provider webhook keyed on paymentRef; bank transfer carries instructions
  // and is confirmed by the platform team.
  paymentMethod       PaymentMethod?
  paymentProvider     String?
  paymentRef          String?    @unique
  paymentInstructions String?
  paymentInitiatedAt  DateTime?
  webhookPayload      Json?

  company     Company @relation(fields: [companyId], references: [id])
  requestedBy User    @relation(fields: [requestedById], references: [id])

  @@index([companyId, status, createdAt])
  @@index([status, createdAt])
}

// GDPR deletion pipeline (US-1003): request → super-admin anonymize.
model DataDeletionRequest {
  id            String            @id @default(uuid(7)) @db.Uuid
  userId        String            @db.Uuid
  status        DataRequestStatus @default(PENDING)
  completedById String?           @db.Uuid
  completedAt   DateTime?
  createdAt     DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
}

// Insert-only at the application layer; no update/delete paths exist in the
// API. For defence in depth, production migrations can additionally
// A marketplace search a user chose to keep: its params re-run as a link, and
// a daily job alerts on new matching listings since the last notification.
model SavedSearch {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @db.Uuid
  name           String
  params         Json
  lastNotifiedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Failed email/WhatsApp deliveries land here and are retried with backoff —
// notify() stays fire-and-forget for callers, but a provider outage no longer
// silently drops the message.
model NotificationOutbox {
  id            String    @id @default(uuid(7)) @db.Uuid
  channel       String
  recipient     String
  payload       Json
  attempts      Int       @default(1)
  nextAttemptAt DateTime
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([sentAt, nextAttemptAt])
}

// Freshness record per scheduled job (P0 remediation): written by every run
// (cron worker or the HTTP dispatcher), it powers the /admin job-health view
// and the "did the clock tick?" alert that finding 01 lacked.
model JobHeartbeat {
  name       String    @id
  lastRunAt  DateTime
  lastOkAt   DateTime?
  lastError  String?
  durationMs Int?
  updatedAt  DateTime  @updatedAt
}

// Shared rate-limit state for the security-sensitive throttles (login, OTP,
// register, password reset). In-memory counters are per-instance and therefore
// ineffective on serverless; long-window limits live here instead. Short-window
// burst limits stay in-memory by design — see HybridThrottlerStorage.
model ThrottleBucket {
  key          String    @id
  count        Int
  expiresAt    DateTime
  blockedUntil DateTime?

  @@index([expiresAt])
}

// REVOKE UPDATE, DELETE on this table from the app role.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String?  @db.Uuid
  actorEmail  String?
  companyId   String?  @db.Uuid
  action      String
  entityType  String?
  entityId    String?
  oldValues   Json?
  newValues   Json?
  reason      String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}
