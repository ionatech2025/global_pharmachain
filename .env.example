# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://pharmachain:pharmachain@localhost:5432/pharmachain"

# ─── Auth (shared by web + api; generate with: openssl rand -base64 32) ──────
AUTH_SECRET="change-me-generate-a-random-32-byte-secret"
# Auth.js base URL of the web app
AUTH_URL="http://localhost:3000"

# ─── API service ─────────────────────────────────────────────────────────────
API_PORT="3001"
# Origins allowed by the API's CORS policy (comma-separated)
CORS_ORIGINS="http://localhost:3000"
# Public URL of the web app (used in email deep links)
APP_URL="http://localhost:3000"
# Run scheduled jobs inside the API process (true) or as a separate worker
JOBS_IN_PROCESS="true"

# ─── Web app ─────────────────────────────────────────────────────────────────
# URL the web server uses to reach the API (server-side + proxy route)
API_URL="http://localhost:3001"

# ─── Object storage: Cloudflare R2 ───────────────────────────────────────────
# Production uses Cloudflare R2, reached over its S3-compatible API (which is
# why the client is an S3 signer). docker-compose ships MinIO as the local
# stand-in, configured through these same variables.
#
# In production:
#   R2_ENDPOINT="https://<cloudflare-account-id>.r2.cloudflarestorage.com"
#   R2_REGION="auto"          # R2 requires "auto"; it has no AWS regions
#   R2_BUCKET="pharmachain-documents"
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY  → an R2 API token
#
# All five are REQUIRED in production — the API refuses to boot on these dev
# defaults rather than silently presigning http://localhost:9000. The bucket
# needs no CORS rule: upload bytes go through the API, not the browser.
R2_ENDPOINT="http://localhost:9000"
R2_REGION="auto"
R2_BUCKET="pharmachain-documents"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"

# ─── Email ───────────────────────────────────────────────────────────────────
# Setting SMTP_HOST is what turns real email on; with it empty, messages are
# printed to stdout instead (this is how OTP codes and invite links are read in
# local development). EMAIL_PROVIDER only overrides that: "console" keeps a
# machine with real credentials printing, "smtp" forces the relay and fails
# startup if SMTP_HOST is missing — better than quietly logging reset links.
# SMTP_SECURE follows the port when left empty: implicit TLS on 465, STARTTLS
# on 587/25. Leave SMTP_USER/SMTP_PASSWORD empty for an unauthenticated relay.
# EMAIL_FROM defaults to SMTP_USER; set it when the relay allows another sender.
# Consumer mailbox providers (Gmail, Outlook, Yahoo, iCloud) send only as the
# account you authenticate as and silently replace any other From — so with one
# of those hosts we send the authenticated mailbox and keep EMAIL_FROM as
# Reply-To. If you have authorised the address at the provider (Gmail's
# Settings > Accounts > "Send mail as"), set EMAIL_FROM_VERIFIED=true and
# EMAIL_FROM is used exactly as written.
EMAIL_PROVIDER=""
EMAIL_FROM=""
EMAIL_FROM_VERIFIED=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""

# ─── WhatsApp notifications (console stub in Phase 1) ────────────────────────
WHATSAPP_PROVIDER="console"

# ─── Seed (local/dev only — change before seeding anything shared) ───────────
SEED_SUPER_ADMIN_EMAIL="admin@pharmachain.local"
SEED_SUPER_ADMIN_PASSWORD="admin-ChangeMe-1"

